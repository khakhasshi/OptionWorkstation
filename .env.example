# Historical replay data. Market data is not distributed with this repository.
OPTION_WORKSTATION_DATA_ROOT=./data

# Local service binding. Keep 127.0.0.1 unless you intentionally add network controls.
OPTION_WORKSTATION_HOST=127.0.0.1
OPTION_WORKSTATION_PORT=7311

# Analytics configuration.
OPTION_WORKSTATION_RISK_FREE_RATE=0.043
OPTION_WORKSTATION_FRONTEND_DIST=./frontend/dist

# Append-only local research ledger.
OPTION_WORKSTATION_AUDIT_PATH=./.option-workstation/audit.jsonl

# Optional OpenAI-compatible snapshot assistant. The key is read only by the
# Rust process; never expose it through VITE_* variables or commit a real value.
# OPTION_WORKSTATION_LLM_API_KEY=
# OPTION_WORKSTATION_LLM_MODEL=gpt-5-mini
# OPTION_WORKSTATION_LLM_BASE_URL=https://api.openai.com/v1
# OPTION_WORKSTATION_LLM_MOCK=1

# Optional local-only Longbridge test credentials. Prefer OAuth in normal use.
# Keep real values in the ignored .env with chmod 600.
# LONGBRIDGE_APP_KEY=
# LONGBRIDGE_APP_SECRET=
# LONGBRIDGE_ACCESS_TOKEN=

# Optional ThetaData live snapshot polling. Run ./scripts/setup-thetadata.sh
# first, then either connect with the in-app form or provide process environment
# credentials. Real values belong only in the ignored chmod-600 .env.
# OPTION_WORKSTATION_THETADATA_PYTHON=./.venv-thetadata/bin/python
# OPTION_WORKSTATION_THETADATA_POLL_SECONDS=5
# OPTION_WORKSTATION_THETADATA_STALE_AFTER_MS=15000
# THETADATA_EMAIL=
# THETADATA_PASSWORD=
# THETADATA_CREDENTIALS_FILE=

# Paper-order submission is disabled by default. Enabling this still requires
# a recognized paper account, a fresh strategy preview, and typed confirmation.
# OPTION_WORKSTATION_PAPER_ORDER_EXECUTION=1

RUST_LOG=option_workstation=info,tower_http=info
